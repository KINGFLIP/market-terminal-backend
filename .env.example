# --- Server ---
PORT=4000
POLL_INTERVAL_MS=5000

# --- Robinhood Chain RPC (for Chainlink feed reads) ---
# This is Robinhood's own official public endpoint — free, no signup, no API key.
# It's rate-limited, so if you outgrow it later, swap in a dedicated provider
# (Chainstack, QuickNode, Alchemy all support Robinhood Chain).
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663

# --- Robinhood Stock Token REST API (read-only, no key required per public docs) ---
ROBINHOOD_API_BASE=https://api.robinhood.com/rhj

# --- Crypto price source (CoinGecko public API, no key required for basic usage) ---
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# --- Smart money thresholds ---
# Minimum USD value of a transfer before it's logged as a "smart money" event.
SMART_MONEY_MIN_USD=50000

# --- Tracked wallets (comma-separated addresses) ---
TRACKED_WALLETS=0x0000000000000000000000000000000000000000
